<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>English Debate Competition — Bracket & Draw</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --pu:#5B2A86;--pu-d:#3B1A5A;--pu-l:#F1E9F8;
  --rd:#B3202A;--rd-d:#7A141B;--rd-l:#FCE8E9;
  --bg:#F7F5FA;--card:#FFFFFF;--bd:#E6E0EE;--bd2:#D3CADF;
  --tx:#1F1A26;--mu:#6F6879;--mu2:#A39CAD;
}
*{box-sizing:border-box}
body{margin:0;font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--tx)}
header{background:var(--pu);color:#fff;padding:28px 32px 24px;border-bottom:6px solid var(--rd)}
header .kicker{font-size:13px;letter-spacing:.08em;text-transform:uppercase;opacity:.75;margin:0 0 6px}
header h1{margin:0;font-size:30px;font-weight:700}
header p.sub{margin:6px 0 0;opacity:.85;font-size:15px}
main{max-width:1180px;margin:0 auto;padding:28px 24px 48px}
.top{display:grid;grid-template-columns:minmax(300px,1.1fr) minmax(280px,1fr);gap:20px;margin-bottom:28px}
@media(max-width:760px){.top{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:20px 22px}
.label{font-size:12px;font-weight:600;color:var(--mu);text-transform:uppercase;letter-spacing:.06em;margin:0 0 10px}
#roll{font-size:30px;font-weight:700;margin:0;min-height:42px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .2s}
#rollSub{font-size:14px;color:var(--mu);margin:4px 0 18px;min-height:22px}
.btns{display:flex;gap:10px;flex-wrap:wrap}
button{font-family:inherit;font-size:14px;font-weight:600;padding:10px 16px;border-radius:10px;border:1px solid var(--bd2);background:#fff;color:var(--tx);cursor:pointer;transition:transform .08s,background .15s}
button:hover{background:var(--pu-l)}
button:active{transform:scale(.97)}
button.primary{background:var(--pu);border-color:var(--pu);color:#fff}
button.primary:hover{background:var(--pu-d)}
button.danger{color:var(--rd)}
button.danger:hover{background:var(--rd-l)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:13px;font-weight:500;padding:6px 12px;border-radius:999px;background:var(--pu-l);color:var(--pu-d)}
.chip.out{background:transparent;color:var(--mu2);text-decoration:line-through;border:1px dashed var(--bd2)}
.hint{font-size:13px;color:var(--mu);margin:16px 0 0;line-height:1.6}
.legend{display:flex;gap:18px;font-size:13px;color:var(--mu);margin:0 0 14px;align-items:center}
.wrap{overflow-x:auto;padding-bottom:6px}
#br{display:grid;grid-template-columns:repeat(3,minmax(240px,1fr));gap:28px;min-width:780px}
.colh{font-size:13px;font-weight:700;color:var(--pu);text-transform:uppercase;letter-spacing:.06em;margin:0 0 12px;padding-bottom:8px;border-bottom:2px solid var(--pu-l)}
.col{display:flex;flex-direction:column;justify-content:space-around;gap:16px;height:calc(100% - 42px)}
.mc{background:var(--card);border:1px solid var(--bd);border-radius:14px;overflow:hidden}
.mc.final{border:2px solid var(--pu)}
.mc.third{border:2px solid var(--rd)}
.mh{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:600;color:var(--mu);padding:8px 12px;border-bottom:1px solid var(--bd);min-height:38px;background:#FBFAFD}
.sb{font-size:12px;padding:5px 10px;border-radius:8px;background:var(--pu-l);border:none;color:var(--pu-d)}
.sb:hover{background:#E4D5F2}
.sb.re{background:var(--rd-l);color:var(--rd-d)}
.sb.re:hover{background:#F8D3D5}
.tr{display:flex;align-items:center;gap:10px;padding:10px 12px;font-size:14px;min-height:44px}
.tr+.tr{border-top:1px solid var(--bd)}
.ck{cursor:pointer}
.ck:hover{background:#FAF7FD}
.win{font-weight:700;background:var(--pu-l)}
.win:hover{background:var(--pu-l)}
.lose .nm{color:var(--mu2)}
.nm{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ph{color:var(--mu2);font-weight:400}
.pl{font-size:11px;font-weight:700;padding:3px 8px;border-radius:6px;min-width:38px;text-align:center}
.pa{background:var(--pu);color:#fff}
.po{background:var(--rd);color:#fff}
.pn{background:#EFECF3;color:var(--mu2)}
.check{color:var(--pu);font-weight:700}
.pod{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
@media(max-width:640px){.pod{grid-template-columns:1fr}}
.pc{border-radius:14px;padding:18px 20px;background:var(--card);border:1px solid var(--bd)}
.pc .t{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px}
.pc .n{font-size:20px;font-weight:700;margin:0}
.pc.g{background:var(--pu);border-color:var(--pu);color:#fff}
.pc.g .t{color:#E4D5F2}
.pc.s .t{color:var(--rd)}
.pc.b .t{color:var(--mu)}
.empty{opacity:.55;font-weight:500!important}
.roster{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.rc{background:var(--card);border:1px solid var(--bd);border-top:4px solid var(--pu);border-radius:0 0 12px 12px;padding:14px 16px}
.rc h3{font-size:15px;margin:0 0 8px}
.rc p{font-size:13px;color:var(--mu);margin:0 0 4px;line-height:1.5}
.rc p span{color:var(--mu2)}
.sec{margin:40px 0 14px}
@media print{.controls,.btns,.sb,.hint{display:none!important}body{background:#fff}header{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>
<header>
  <p class="kicker">Kolese Mikael</p>
  <h1>English Debate Competition</h1>
  <p class="sub">Preliminaries · Semifinals · 3rd place · Final</p>
</header>

<main>
  <div class="top controls">
    <div class="panel">
      <p class="label">Lottery box</p>
      <p id="roll">Ready to draw</p>
      <p id="rollSub">8 teams · 4 preliminary matches</p>
      <div class="btns">
        <button class="primary" id="bOne">Draw one team</button>
        <button id="bAll">Draw all</button>
        <button class="danger" id="bReset">Reset</button>
      </div>
    </div>
    <div class="panel">
      <p class="label">Teams in the pool</p>
      <div class="chips" id="pool"></div>
      <p class="hint">Click a team name in the bracket to set the winner, and click it again to undo. Stances for the semifinals, the final, and the 3rd place match are drawn with the button on each match and can be redrawn.</p>
    </div>
  </div>

  <div class="legend">
    <span><span class="pl pa">AFF</span>&nbsp; Affirmative</span>
    <span><span class="pl po">OPP</span>&nbsp; Opposition</span>
  </div>

  <div class="wrap"><div id="br"></div></div>

  <div class="pod" id="pod"></div>

  <p class="colh sec">Team roster</p>
  <div class="roster" id="roster"></div>
</main>

<script>
const TEAMS=[
{id:'jdb',name:'Kolese de Britto',m:[['Yohanes Agastya Dharmaputra','XI 6'],['Raphael Nathan Sugianto','XI 6'],['Ananggata Putra Pangestu Rambadeta','XI 8']]},
{id:'gzg',name:'Kolese Gonzaga',m:[['Farah Maemee Sarofa','X-6'],['Emily Then','X-9'],['Faith Katherine Crestabelle Ruru','X-9']]},
{id:'ksp',name:'Kolese Kanisius SMP',m:[['Kenzo Devano','8-5'],['Gabriel Amadeo Olyviardy','9-6'],['Tobias Ramot Diomega Hutajulu','9-4']]},
{id:'ksa',name:'Kolese Kanisius SMA',m:[['Raphael Louis Christ','11-3'],['Nathanael Ethan Santoso','12-1'],['Nicholas Raka Satria Purwadi','12-6']]},
{id:'loy',name:'Kolese Loyola',m:[['Kanaya Arsanti Loeksono','Grade X'],['Cherlyne Averina Wibowo','Grade XI'],['Asia Titania Suhendra','Grade XII']]},
{id:'mik',name:'Kolese Mikael',m:[['Al-Fath Dhiya Faeyza','XI TP-6'],['Giorgio Maxwell Antony','XII TP-2'],['Jonathan Edward Yuwono','XII TP-4']]},
{id:'pika',name:'PIKA',m:[['Asa Oktavia Putri Yos Indiawan','Grade XI'],['Bhernardus Airlangga','Grade XII'],['The Axelle A. S','Grade XII']]},
{id:'sem',name:'Seminari',m:[['Rafael Sukma Narendra','X-1'],['Joseph Johannes Palimbong','X-2'],['Rohfel Adyaraka Christianugrah Puspoasmoro','XII-1']]}
];
const B=Object.fromEntries(TEAMS.map(t=>[t.id,t]));
const LBL={p0:'Prelim 1',p1:'Prelim 2',p2:'Prelim 3',p3:'Prelim 4',s0:'Semifinal 1',s1:'Semifinal 2',f:'Final',t:'3rd place match'};
const ORDER=['p0','p1','p2','p3','s0','s1','f','t'];
const KEY='debateBracketV2';
const $=id=>document.getElementById(id);
const rnd=()=>Math.random()<.5?'A':'O';
const opp=v=>v?(v==='A'?'O':'A'):null;

let S=load()||fresh();
let busy=false;
const anim={};

function fresh(){return{slots:Array(8).fill(null),st:{},w:{}}}
function save(){localStorage.setItem(KEY,JSON.stringify(S))}
function load(){try{return JSON.parse(localStorage.getItem(KEY))}catch(e){return null}}

function parts(m){
  if(m[0]==='p'){const i=+m[1];return[S.slots[2*i],S.slots[2*i+1]]}
  if(m==='s0')return[S.w.p0||null,S.w.p1||null];
  if(m==='s1')return[S.w.p2||null,S.w.p3||null];
  if(m==='f')return[S.w.s0||null,S.w.s1||null];
  return[loser('s0'),loser('s1')];
}
function loser(m){
  const p=parts(m);
  if(!S.w[m]||!p[0]||!p[1])return null;
  return p[0]===S.w[m]?p[1]:p[0];
}
function clean(){
  ORDER.forEach(m=>{
    const p=parts(m);
    if(S.w[m]&&!(p[0]&&p[1]&&p.includes(S.w[m])))delete S.w[m];
    if(m[0]!=='p'&&S.st[m]&&S.st[m].k!==p.join())delete S.st[m];
  });
}
function pill(v){
  return v?`<span class="pl ${v==='A'?'pa':'po'}">${v==='A'?'AFF':'OPP'}</span>`:'<span class="pl pn">—</span>';
}
function row(m,id,v,ready){
  const w=S.w[m],isW=id&&w===id,hasW=!!w;
  const ph=m[0]==='p'?'Awaiting draw':'Awaiting winner';
  const tip=id?B[id].m.map(x=>x[0]).join(', '):'';
  return `<div class="tr ${ready?'ck':''} ${isW?'win':''} ${hasW&&!isW?'lose':''}" data-m="${m}" data-t="${id||''}" title="${tip}">
    ${pill(id?v:null)}
    <span class="nm">${id?B[id].name:`<span class="ph">${ph}</span>`}</span>
    ${isW?'<span class="check">✓</span>':''}
  </div>`;
}
function card(m){
  const p=parts(m),ready=!!(p[0]&&p[1]);
  let v=anim[m]||(S.st[m]?S.st[m].v:null);
  let btn='';
  if(m[0]!=='p'&&ready){
    btn=S.st[m]
      ?`<button class="sb re" data-coin="${m}">↻ Redraw stance</button>`
      :`<button class="sb" data-coin="${m}">Draw stance</button>`;
  }
  const cls=m==='f'?'final':m==='t'?'third':'';
  return `<div class="mc ${cls}"><div class="mh"><span>${LBL[m]}</span>${btn}</div>${row(m,p[0],v,ready)}${row(m,p[1],opp(v),ready)}</div>`;
}
function render(){
  clean();
  $('br').innerHTML=`
    <div><p class="colh">Preliminaries</p><div class="col">${['p0','p1','p2','p3'].map(card).join('')}</div></div>
    <div><p class="colh">Semifinals</p><div class="col">${card('s0')}${card('s1')}</div></div>
    <div><p class="colh">Finals</p><div class="col" style="justify-content:center;gap:36px">${card('f')}${card('t')}</div></div>`;
  $('pool').innerHTML=TEAMS.map(t=>`<span class="chip ${S.slots.includes(t.id)?'out':''}">${t.name}</span>`).join('');
  const c1=S.w.f,c2=loser('f'),c3=S.w.t;
  const pc=(cls,lab,id)=>`<div class="pc ${cls}"><p class="t">${lab}</p><p class="n ${id?'':'empty'}">${id?B[id].name:'To be decided'}</p></div>`;
  $('pod').innerHTML=pc('g','Champion',c1)+pc('s','Runner-up',c2)+pc('b','3rd place',c3);
  save();
}
$('roster').innerHTML=TEAMS.map(t=>`<div class="rc"><h3>${t.name}</h3>${t.m.map(x=>`<p>${x[0]} <span>· ${x[1]}</span></p>`).join('')}</div>`).join('');

function setRoll(name,v,sub){
  $('roll').textContent=name;
  $('roll').style.color=v==='A'?'var(--pu)':v==='O'?'var(--rd)':'';
  $('rollSub').textContent=sub;
}

function drawOne(dur){
  return new Promise(res=>{
    const idx=S.slots.indexOf(null);
    if(idx<0){res();return}
    const pool=TEAMS.map(t=>t.id).filter(id=>!S.slots.includes(id));
    $('roll').style.color='var(--mu)';
    $('rollSub').textContent='Drawing…';
    const iv=setInterval(()=>{$('roll').textContent=B[pool[Math.floor(Math.random()*pool.length)]].name},60);
    setTimeout(()=>{
      clearInterval(iv);
      const pick=pool[Math.floor(Math.random()*pool.length)];
      const m='p'+(idx>>1);
      if(idx%2===0)S.st[m]={v:rnd(),k:''};
      S.slots[idx]=pick;
      const v=idx%2===0?S.st[m].v:opp(S.st[m].v);
      setRoll(B[pick].name,v,`${LBL[m]} · ${v==='A'?'Affirmative':'Opposition'}`);
      render();res();
    },dur);
  });
}

function drawStance(m){
  if(busy)return;
  const p=parts(m);
  if(!p[0]||!p[1])return;
  busy=true;
  let n=0;
  $('roll').style.color='var(--mu)';
  $('roll').textContent=LBL[m];
  $('rollSub').textContent='Drawing stance…';
  const iv=setInterval(()=>{anim[m]=n++%2?'A':'O';render()},90);
  setTimeout(()=>{
    clearInterval(iv);
    delete anim[m];
    const v=rnd();
    S.st[m]={v,k:p.join()};
    const aff=v==='A'?p[0]:p[1],op=v==='A'?p[1]:p[0];
    setRoll(B[aff].name,'A',`${LBL[m]} · Affirmative vs ${B[op].name} (Opposition)`);
    render();
    busy=false;
  },1100);
}

$('bOne').onclick=async()=>{
  if(busy)return;
  if(S.slots.indexOf(null)<0){$('rollSub').textContent='All preliminary slots are filled';return}
  busy=true;await drawOne(1500);busy=false;
};
$('bAll').onclick=async()=>{
  if(busy)return;
  if(S.slots.indexOf(null)<0){$('rollSub').textContent='All preliminary slots are filled';return}
  busy=true;
  while(S.slots.indexOf(null)>=0)await drawOne(700);
  busy=false;
};
$('bReset').onclick=()=>{
  if(busy)return;
  if(!confirm('Reset the whole bracket and draw again?'))return;
  S=fresh();
  setRoll('Ready to draw',null,'8 teams · 4 preliminary matches');
  render();
};
$('br').addEventListener('click',e=>{
  const c=e.target.closest('[data-coin]');
  if(c){drawStance(c.dataset.coin);return}
  if(busy)return;
  const r=e.target.closest('.tr.ck');
  if(!r||!r.dataset.t)return;
  const m=r.dataset.m,id=r.dataset.t;
  if(S.w[m]===id)delete S.w[m];else S.w[m]=id;
  render();
});

render();
</script>
</body>
</html>
